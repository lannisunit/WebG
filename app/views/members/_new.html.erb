<div class="min-h-screen flex gap-1">

  <!-- FORM -->
  <div class="w-full max-w-md p-2">

    <%= form_with model: @member do |f| %>

      <div>
        <%= f.label :name, "Tên", class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.text_field :name,
              class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none",
              placeholder: "Nhập tên..." %>
      </div>

      <div class="pt-2">
        <%= f.submit "Thêm",
              class: "w-full bg-black hover:bg-blue-600 text-white font-semibold py-2 rounded-lg transition" %>
      </div>

    <% end %>

  </div>

  <!-- LIST -->
  <div class="w-full max-w-md border-l border-black p-2">

    <% @members.each do |member| %>
      <div class="py-1 border-b">
        <%= member.name %>
      </div>
    <% end %>

  </div>

</div>