<!-- TABS -->
<div class="w-full">
  <div class="flex border-b w-full text-sm md:text-base">
    <button class="tab-btn flex-1 py-2 text-center"
            onclick="openTab('tab1', this)">
      5v5
    </button>
    <button class="tab-btn flex-1 py-2 text-center"
            onclick="openTab('tab2', this)">
      Random
    </button>
    <button class="tab-btn flex-1 py-2 text-center"
            onclick="openTab('tab3', this)">
      Tỉ lệ thắng
    </button>
    <button class="tab-btn flex-1 py-2 text-center"
            onclick="openTab('tab4', this)">
      Thêm thành viên
    </button>
  </div>
</div>


<!-- CONTENT -->
<div class="p-4 w-full">

  <!-- TAB 1 -->
  <div id="tab1" class="tab-content w-full">

    <!-- TABLE SCROLL FIX -->
    <div class="w-full">
      <table class="w-full border text-center table-fixed">

        <tbody>

          <!-- ICON ROW -->
          <tr class="bg-black">
            <td class="border px-2 py-2 text-white font-semibold">Bo 1</td>

            <td class="border bg-black">
              <%= image_tag "Rung.jpg", class: "mx-auto w-8 h-8 object-contain" %>
            </td>

            <td class="border bg-black">
              <%= image_tag "Top.jpg", class: "mx-auto w-8 h-8 object-contain" %>
            </td>

            <td class="border bg-black">
              <%= image_tag "Ad.jpg", class: "mx-auto w-10 h-10 object-contain" %>
            </td>

            <td class="border bg-black">
              <%= image_tag "Ad.jpg", class: "mx-auto w-10 h-10 object-contain" %>
            </td>

            <td class="border bg-black">
              <%= image_tag "Sp.jpg", class: "mx-auto w-10 h-10 object-contain" %>
            </td>
          </tr>

        <!-- TEAM 1 -->
        <tr>
          <td class="border px-2 py-2 font-semibold bg-black text-white">Team 1</td>
        
          <% @team1.each do |m| %>
            <td class="border px-2 py-2"><%= m.name %></td>
          <% end %>
        </tr>
          
        <!-- TEAM 2 -->
        <tr>
          <td class="border px-2 py-2 font-semibold bg-black text-white">Team 2</td>
          
          <% @team2.each do |m| %>
            <td class="border px-2 py-2"><%= m.name %></td>
          <% end %>
        </tr>

        </tbody>
      </table>
    </div>

  </div>


  <!-- TAB 2 -->
  <div id="tab2" class="tab-content hidden min-h-screen flex gap-1">
    <%= render "teams/new" %>
  </div>

  <!-- TAB 3 -->
  <div id="tab3" class="tab-content hidden">

  

  <table class="w-full border text-center">

    <thead>
      <tr class="bg-black text-white">
        <th class="border px-2 py-2">Tên</th>
        <th class="border px-2 py-2">Số lần tham gia</th>
        <th class="border px-2 py-2">Tỉ lệ thắng</th>
      </tr>
    </thead>

    <tbody>
      <% @members.each do |member| %>
        <tr>
          <td class="border px-2 py-2">
            <%= member.name %>
          </td>

          <td class="border px-2 py-2">
            <%= member.join_count || 0 %>
          </td>

          <td class="border px-2 py-2">
            <%= member.join_count.to_i == 0 ? 0 : (member.win_count.to_f / member.join_count * 100).round(1) %>%  
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>


  </div>

  <!-- TAB 4 -->
  <div id="tab4" class="tab-content hidden">
    <%= render "members/new" %>
  </div>

</div>


<!-- SCRIPT -->
<script>
function openTab(tabId, el) {
  document.querySelectorAll(".tab-content").forEach(tab => tab.classList.add("hidden"));
  document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("border-blue-500"));

  document.getElementById(tabId).classList.remove("hidden");
  el.classList.add("border-blue-500");
}
</script>